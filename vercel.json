{
  "outputDirectory": "frontend/web",
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/api",
      "dest": "/api/index.py"
    },
    {
      "src": "/mcp/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/mcp",
      "dest": "/api/index.py"
    },
    {
      "src": "/healthcheck",
      "dest": "/api/index.py"
    },
    {
      "handle": "filesystem"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "frontend/web/**"
    }
  }
}