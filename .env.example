# General settings
PORT=10000
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=10
API_BASE_URL=http://localhost:10000

# Backend toggles
# ENABLE_BACKEND_WEB controls whether frontend static files are mounted and served (default true)
ENABLE_BACKEND_WEB=true

# ENABLE_BACKEND_MCP controls whether Model Context Protocol (MCP) endpoint is mounted (default true)
ENABLE_BACKEND_MCP=true
